# Compose interpolation (the `${...}` in docker-compose.yaml); these never reach the application.
POSTGRES_USER=leitstand
POSTGRES_DB=leitstand
# No POSTGRES_PASSWORD: Postgres reads secrets/leitstand_db_password.
# Interface the backend port binds to; anything but loopback exposes it to the LAN.
# BACKEND_BIND_ADDR=127.0.0.1

# Application settings. Credentials are one file each under secrets/, not here.

# HTTP server
LEITSTAND_HTTP_HOST=127.0.0.1
LEITSTAND_HTTP_PORT=8080
LEITSTAND_LOG_LEVEL=INFO

# Zenoh client connection (the router itself is started by docker compose)
LEITSTAND_ZENOH_ENDPOINT=tcp/127.0.0.1:7447
# LEITSTAND_ZENOH_CONFIG=
# LEITSTAND_ZENOH_DISABLED=false

# Database. Password: secrets/leitstand_db_password; one written into the URL wins over the file.
LEITSTAND_DATABASE_URL=postgresql+asyncpg://leitstand@localhost:5432/leitstand
LEITSTAND_AUTO_MIGRATE=true
LEITSTAND_DB_POOL_SIZE=10

# Auth. Token: secrets/leitstand_auth_bearer_token; an empty file leaves the API open.
# TODO user management and auth service
# LEITSTAND_CORS_ORIGINS=http://localhost:5173

# LLM (any OpenAI-compatible endpoint). Key: secrets/leitstand_llm_api_key.
LEITSTAND_LLM_BASE_URL=http://localhost:8000/v1
LEITSTAND_LLM_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
LEITSTAND_LLM_CONNECT_TIMEOUT_S=3
LEITSTAND_LLM_READ_TIMEOUT_S=60
LEITSTAND_LLM_REASONING=off

# Chat
LEITSTAND_CHAT_ENABLED=true
LEITSTAND_CHAT_MAX_TOOL_CALLS=10

# Coverage planner service. Unset means coverage planning answers 503 and nothing else changes.
LEITSTAND_COVERAGE_PLANNER_URL=http://localhost:8090
LEITSTAND_COVERAGE_PLANNER_CONNECT_TIMEOUT_S=3
LEITSTAND_COVERAGE_PLANNER_READ_TIMEOUT_S=60
# Point spacing along a planned turn, in metres. Straights are not sampled, so this alone decides
# what a field costs to dispatch.
LEITSTAND_COVERAGE_TURN_SAMPLE_M=0.25
# How fast curvature may change per metre, in 1/m2. Fields2Cover's default is 2.0; 200 is free.
LEITSTAND_COVERAGE_LINEAR_CURV_CHANGE=200.0
