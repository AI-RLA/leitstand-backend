# Postgres credentials (used by docker compose)
POSTGRES_USER=leitstand
POSTGRES_PASSWORD=leitstand
POSTGRES_DB=leitstand

# Backend HTTP server
LEITSTAND_HTTP_HOST=127.0.0.1
LEITSTAND_HTTP_PORT=8080
LEITSTAND_LOG_LEVEL=INFO

# Zenoh client connection (the router itself is started by docker compose)
LEITSTAND_ZENOH_ENDPOINT=tcp/127.0.0.1:7447
# LEITSTAND_ZENOH_CONFIG=
# LEITSTAND_ZENOH_DISABLED=false

# Database
LEITSTAND_DATABASE_URL=postgresql+asyncpg://leitstand:leitstand@localhost:5432/leitstand
LEITSTAND_AUTO_MIGRATE=true
LEITSTAND_DB_POOL_SIZE=10

# Auth (unset leaves the API open). One shared token, not per-user identity. # TODO user management and auth service
# LEITSTAND_AUTH_BEARER_TOKEN=
# LEITSTAND_CORS_ORIGINS=http://localhost:5173

# LLM (any OpenAI-compatible endpoint)
LEITSTAND_LLM_BASE_URL=http://localhost:8000/v1
LEITSTAND_LLM_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
# LEITSTAND_LLM_API_KEY=
LEITSTAND_LLM_CONNECT_TIMEOUT_S=3
LEITSTAND_LLM_READ_TIMEOUT_S=60
LEITSTAND_LLM_REASONING=off

# Chat
LEITSTAND_CHAT_ENABLED=true
LEITSTAND_CHAT_MAX_TOOL_CALLS=10
