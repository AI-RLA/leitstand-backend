# Postgres credentials (used by docker compose)
POSTGRES_USER=leitstand
POSTGRES_PASSWORD=leitstand
POSTGRES_DB=leitstand

# Backend HTTP server
LEITSTAND_HTTP_HOST=127.0.0.1
LEITSTAND_HTTP_PORT=8080
LEITSTAND_LOG_LEVEL=INFO

# Zenoh client connection (the router itself is started by docker compose)
LEITSTAND_ZENOH_ENDPOINT=tcp/127.0.0.1:7447
# LEITSTAND_ZENOH_CONFIG=
# LEITSTAND_ZENOH_DISABLED=false

# Database
LEITSTAND_DATABASE_URL=postgresql+asyncpg://leitstand:leitstand@localhost:5432/leitstand
LEITSTAND_AUTO_MIGRATE=true
LEITSTAND_DB_POOL_SIZE=10
