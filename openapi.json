  "components": {
    "schemas": {
      "Battery": {
        "properties": {
          "ts": {
            "type": "string",
            "format": "date-time",
            "title": "Ts"
          },
          "battery_pct": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Battery Pct"
          },
          "charging": {
            "type": "boolean",
            "title": "Charging"
          }
        },
        "type": "object",
        "required": [
          "ts",
          "battery_pct",
          "charging"
        ],
        "title": "Battery"
      },
      "FieldCreate": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "geometry": {
            "$ref": "#/components/schemas/Polygon"
          },
          "notes": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Notes"
          }
        },
        "type": "object",
        "required": [
          "name",
          "geometry"
        ],
        "title": "FieldCreate"
      },
      "FieldUpdate": {
        "properties": {
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          },
          "geometry": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Polygon"
              },
              {
                "type": "null"
              }
            ]
          },
          "notes": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Notes"
          }
        },
        "type": "object",
        "title": "FieldUpdate"
      },
      "FieldView": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "geometry": {
            "$ref": "#/components/schemas/Polygon"
          },
          "area_ha": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Area Ha"
          },
          "notes": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Notes"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "geometry",
          "area_ha",
          "notes",
          "created_at",
          "updated_at"
        ],
        "title": "FieldView"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Metadata": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          }
        },
        "additionalProperties": true,
        "type": "object",
        "required": [
          "id"
        ],
        "title": "Metadata"
      },
      "Polygon": {
        "properties": {
          "bbox": {
            "anyOf": [
              {
                "prefixItems": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  }
                ],
                "type": "array",
                "maxItems": 4,
                "minItems": 4
              },
              {
                "prefixItems": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  }
                ],
                "type": "array",
                "maxItems": 6,
                "minItems": 6
              },
              {
                "type": "null"
              }
            ],
            "title": "Bbox"
          },
          "type": {
            "type": "string",
            "const": "Polygon",
            "title": "Type"
          },
          "coordinates": {
            "items": {
              "items": {
                "anyOf": [
                  {
                    "$ref": "#/components/schemas/Position2D"
                  },
                  {
                    "$ref": "#/components/schemas/Position3D"
                  }
                ]
              },
              "type": "array",
              "minItems": 4
            },
            "type": "array",
            "title": "Coordinates"
          }
        },
        "type": "object",
        "required": [
          "type",
          "coordinates"
        ],
        "title": "Polygon",
        "description": "Polygon Model"
      },
      "Pose": {
        "properties": {
          "ts": {
            "type": "string",
            "format": "date-time",
            "title": "Ts"
          },
          "frame": {
            "type": "string",
            "const": "wgs84",
            "title": "Frame",
            "default": "wgs84"
          },
          "lat": {
            "type": "number",
            "maximum": 90.0,
            "minimum": -90.0,
            "title": "Lat"
          },
          "lon": {
            "type": "number",
            "maximum": 180.0,
            "minimum": -180.0,
            "title": "Lon"
          },
          "heading_deg": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMaximum": 360.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Heading Deg"
          },
          "horizontal_accuracy_m": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Horizontal Accuracy M"
          }
        },
        "type": "object",
        "required": [
          "ts",
          "lat",
          "lon"
        ],
        "title": "Pose"
      },
      "Position2D": {
        "prefixItems": [
          {
            "type": "number",
            "title": "Longitude"
          },
          {
            "type": "number",
            "title": "Latitude"
          }
        ],
        "type": "array",
        "maxItems": 2,
        "minItems": 2
      },
      "Position3D": {
        "prefixItems": [
          {
            "type": "number",
            "title": "Longitude"
          },
          {
            "type": "number",
            "title": "Latitude"
          },
          {
            "type": "number",
            "title": "Altitude"
          }
        ],
        "type": "array",
        "maxItems": 3,
        "minItems": 3
      },
      "RobotState": {
        "properties": {
          "ts": {
            "type": "string",
            "format": "date-time",
            "title": "Ts"
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "idle",
              "charging",
              "alert"
            ],
            "title": "Status"
          },
          "task": {
            "type": "string",
            "title": "Task",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "ts",
          "status"
        ],
        "title": "RobotState"
      },
      "RobotView": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "metadata": {
            "$ref": "#/components/schemas/Metadata"
          },
          "online": {
            "type": "boolean",
            "title": "Online"
          },
          "last_seen": {
            "type": "string",
            "format": "date-time",
            "title": "Last Seen"
          },
          "pose": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Pose"
              },
              {
                "type": "null"
              }
            ]
          },
          "battery": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Battery"
              },
              {
                "type": "null"
              }
            ]
          },
          "state": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/RobotState"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "id",
          "metadata",
          "online",
          "last_seen"
        ],
        "title": "RobotView"
      },
      "User": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "title": "User"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
